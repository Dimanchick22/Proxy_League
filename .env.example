# ===========================================
# PROXY LEAGUE - ENVIRONMENT CONFIGURATION
# ===========================================
# Скопируйте этот файл в .env и настройте под свои нужды

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=ProxyLeague
COMPOSE_PROJECT_NAME=proxyleague

# ===========================================
# NETWORK & PORTS
# ===========================================
# Backend API port
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=8080

# Frontend port
FRONTEND_PORT=3000
FRONTEND_INTERNAL_PORT=80

# Database port
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proxyleague

# Database connection settings
DB_MAX_CONNECTIONS=100
DB_SSL_MODE=disable

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
# JWT Secret - ОБЯЗАТЕЛЬНО измените в production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# JWT Token expiration (in hours)
JWT_EXPIRATION_HOURS=24

# Server settings
GIN_MODE=debug
LOG_LEVEL=info

# CORS settings
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# HoYoLAB API Credentials (для получения данных героев из Zenless Zone Zero)
# Получить можно из cookies на hoyolab.com после авторизации:
# 1. Откройте https://www.hoyolab.com в браузере
# 2. Авторизуйтесь
# 3. Откройте DevTools (F12) → Application/Storage → Cookies
# 4. Найдите ltoken_v2 и ltuid_v2 и скопируйте их значения
HOYOLAB_LTOKEN_V2=your_ltoken_v2_cookie_value_here
HOYOLAB_LTUID_V2=your_ltuid_v2_cookie_value_here

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# API URLs (используются в runtime)
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1

# Build settings
NODE_ENV=development

# ===========================================
# DOCKER SETTINGS
# ===========================================
# Restart policy
RESTART_POLICY=unless-stopped

# Build arguments
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Enable/disable features
ENABLE_SWAGGER=true
ENABLE_METRICS=false
ENABLE_DEBUG=true

# ===========================================
# PRODUCTION NOTES
# ===========================================
# Для production окружения:
# 1. Измените JWT_SECRET на случайную строку
# 2. Измените пароли БД
# 3. Установите GIN_MODE=release
# 4. Настройте CORS_ALLOW_ORIGINS только для вашего домена
# 5. Установите ENABLE_DEBUG=false
# 6. Используйте SSL для PostgreSQL (DB_SSL_MODE=require)
